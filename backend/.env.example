# ---------- Base de datos ----------
# Con DATABASE_URL usa Postgres real. Sin ella levanta PGlite en un
# directorio local, que sirve para desarrollo pero NO para producción.
DATABASE_URL=postgresql://usuario:clave@host:5432/feria

# ---------- Seguridad ----------
# Firma los códigos de acceso y los tokens de sesión. OBLIGATORIO en
# producción. Si cambia, todas las sesiones abiertas dejan de valer.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FERIA_SECRETO=

# ---------- Pagos ----------
# Con esto, arrancar en producción sin las credenciales de abajo es
# un error en vez de un servidor que no cobra.
PASARELA=mercadopago

# ---------- Mercado Pago (Checkout Pro) ----------
# Access token de la aplicación, en mercadopago.cl/developers >
# Tus integraciones > Credenciales. El de prueba empieza con TEST-
# y manda el checkout al sandbox automáticamente.
MP_ACCESS_TOKEN=
MP_BASE=https://api.mercadopago.com
# Sin el token el servidor NO cobra: en desarrollo deja pasar el
# pedido, y en producción devuelve error en vez de regalarlo.

# URL pública del backend. Mercado Pago la usa para avisar del pago,
# así que tiene que llegar desde internet — localhost no sirve.
URL_PUBLICA=https://api.tudominio.cl

# ---------- SMS ----------
# Sin estas tres variables los códigos salen por consola en vez de
# por mensaje: sirve para desarrollo, no para la feria. En
# producción, sin ellas los clientes no pueden entrar ni comprar
# (al equipo el operador le puede dictar el código desde el panel).
# Cada mensaje se paga.
# Tope de códigos que se pueden pedir desde una misma IP por hora:
# CODIGOS_POR_HORA_POR_IP=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+56000000000

# ---------- Correo ----------
# El comprador puede entrar con un código que le llega al correo,
# sin gastar un SMS. Sin nada de esto el código sale por consola y
# en la pantalla: sirve para desarrollo; en producción ese ingreso
# queda apagado.
#
# Lo más simple: mandar desde una cuenta de Gmail.
#   1. En la cuenta de Google, activa la verificación en dos pasos.
#   2. En myaccount.google.com/apppasswords crea una «contraseña de
#      aplicación» (16 letras). NO es la clave normal de la cuenta.
#   3. Completa estas dos líneas y prueba con:
#        npm run probar-correo -- tu@correo.cl
CORREO_SMTP_USUARIO=
CORREO_SMTP_CLAVE=
# Solo si la casilla no es de Gmail:
# CORREO_SMTP_SERVIDOR=smtp.gmail.com
# CORREO_SMTP_PUERTO=465
# Cómo aparece quien manda. Por defecto «Feria <la casilla>».
# CORREO_REMITENTE=Feria <ingreso@tudominio.cl>
#
# Alternativa con dominio propio: Resend (resend.com). Necesita
# además CORREO_REMITENTE con un dominio verificado ahí.
# RESEND_API_KEY=

# ---------- Google y Apple ----------
# Para que el comprador entre con Google o con Apple. Vacío = ese
# botón no aparece. Van los identificadores para los que se aceptan
# tokens, separados por coma.
# Google: los «client ID» del proyecto en Google Cloud (iOS, Android, web).
GOOGLE_CLIENT_IDS=
# Apple: el identificador de la app.
APPLE_CLIENT_IDS=

# ---------- Privacidad ----------
# La versión de los textos de backend/src/legal/. Al cambiar los
# textos hay que cambiarla: la app vuelve a pedir la aceptación.
LEGAL_VERSION=2026-10-06

# Quién es el proveedor. La Ley 19.496 y el Reglamento de Comercio
# Electrónico obligan a identificarlo en los términos. Mientras falte
# alguno, los textos dicen «[por completar: …]».
LEGAL_RAZON_SOCIAL=
LEGAL_RUT=
LEGAL_REPRESENTANTE=
LEGAL_DOMICILIO=
LEGAL_CORREO=
# Días que se guarda la ubicación de los repartidores.
RETENCION_UBICACIONES_DIAS=30
# Días sin uso tras los cuales la cuenta de un cliente se vacía sola.
RETENCION_CUENTAS_INACTIVAS_DIAS=365
# Días sin uso tras los cuales, al entrar con el teléfono, se pide
# además un código al correo confirmado de la cuenta (si tiene).
DIAS_SEGUNDA_PRUEBA=90
# El certificado (.pem, su contenido) de la autoridad de la base
# administrada. Con él se verifica el servidor de la base; sin él
# la conexión va cifrada pero acepta cualquier certificado.
# PG_CA=

# ---------- Datos en disco ----------
# Base (cuando no hay DATABASE_URL) y fotos subidas desde el panel.
# En Docker va montado como volumen: sin eso, cada despliegue
# empieza sin base y sin fotos.
# Las fotos de referencia del catálogo NO van acá: vienen con el
# código, en src/fotos.
FERIA_DATOS=/datos

# ---------- Direcciones ----------
# Dónde busca Nominatim la dirección que escribe el cliente, y a
# dónde cae un pedido que no se pudo ubicar.
CIUDAD=Valparaíso, Chile
PAIS_ISO=cl
FERIA_LAT=-33.0472
FERIA_LNG=-71.6127

# ---------- Operación ----------
PORT=4000
# Tope de peticiones por IP por minuto. Con varias instancias esto
# tiene que pasar al proxy de adelante.
LIMITE_POR_MINUTO=120
# Cuántos proxies del hosting hay delante del servidor (en casi
# todos, 1). Con esto el freno toma la IP que escribió el proxy y no
# la que el cliente pueda inventar en la cabecera. Sin definir, se
# confía en la cabecera: sirve en desarrollo, no en producción.
# PROXIES_DE_CONFIANZA=1
NODE_ENV=production
# Define qué cuenta como "hoy" para las liquidaciones.
TZ_FERIA=America/Santiago
# Teléfono con el que entra el operador (rol de administración).
OPERADOR_TELEFONO=+56900000009

# Comisión de la pasarela sobre la venta, para el cálculo del margen.
# Mercado Pago Checkout Pro: 3,19% + IVA al instante = 0.038
#                            2,89% + IVA a 10 días   = 0.0344
# Pon la que de verdad vas a pagar: de esto sale el «te queda» del
# panel, y con márgenes de feria cada punto se nota.
TASA_COMISIONES=0.038

# ---------- Desarrollo ----------
# Apaga la geocodificación: los tests no salen a internet.
FERIA_SIN_GEO=0
# Abre la feria todos los días para poder probar un martes. Se
# ignora cuando NODE_ENV=production.
FERIA_SIEMPRE_ABIERTA=1

# --- Tiendas de apps -------------------------------------------------
# «Iniciar sesión con Apple»: el identificador de la app en iPhone.
APPLE_CLIENT_IDS=cl.feria.app

# Para revocar el permiso de Apple cuando alguien elimina una cuenta
# creada con «Iniciar sesión con Apple» (Apple lo exige). Salen de la
# cuenta de desarrollador: Certificates, Identifiers & Profiles →
# Keys → «+» → marcar «Sign in with Apple». El .p8 se descarga una
# sola vez; va entero, con los saltos de línea como \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Cuenta de prueba para quien revisa la app en App Store y Google
# Play: con este correo el código es siempre el mismo y no se manda
# nada. Es una cuenta de comprador común. Se le entrega a la tienda
# en las «notas para la revisión». Sin las dos variables no existe.
REVISION_CORREO=
REVISION_CODIGO=
