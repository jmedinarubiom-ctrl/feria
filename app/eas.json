{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "apk": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "apk",
      "env": {
        "EXPO_PUBLIC_FERIA_API": "https://feria-valpo.loca.lt"
      }
    },
    "desarrollo": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_FERIA_API": "https://feria-valpo.loca.lt"
      }
    },
    "produccion": {
      "autoIncrement": true,
      "channel": "produccion"
    }
  },
  "submit": {
    "produccion": {}
  }
}
